map $request_method $login_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $login_key zone=login:10m rate=30r/m;

gzip on;
gzip_vary on;
gzip_types application/json application/javascript text/css image/svg+xml;

resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80;
    set $fleet_upstream http://api:8000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 8m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${FLEET_ASSET_ORIGIN}; style-src 'self' 'unsafe-inline' ${FLEET_ASSET_ORIGIN}; font-src 'self' ${FLEET_ASSET_ORIGIN}; img-src 'self' data: blob: ${FLEET_ASSET_ORIGIN}; connect-src 'self' blob: ${FLEET_ASSET_ORIGIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    location = /api/access/session {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass $fleet_upstream;
        proxy_set_header Host $host;
    }

    location /api/events {
        proxy_pass $fleet_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
    }

    location /api/ {
        proxy_pass $fleet_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
