# Copy to .env for local development. Replace demonstration values outside local use.
FLEET_ENVIRONMENT=development
FLEET_DATABASE_URL=postgresql+psycopg://fleet:fleet@postgres:5432/fleet
FLEET_BROKER_URL=amqp://fleet:fleet@rabbitmq:5672//
FLEET_ARTIFACT_ROOT=/var/lib/fleet-maintenance/artifacts
FLEET_SESSION_SECRET=replace-for-nonlocal-use
FLEET_AUTO_CREATE_SCHEMA=false
VITE_API_BASE_URL=/api
