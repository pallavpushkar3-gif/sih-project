{
  "name": "fleet-maintenance-workspace",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "corepack pnpm --filter @fleet-maintenance/web dev",
    "build": "corepack pnpm --filter @fleet-maintenance/web build",
    "lint": "corepack pnpm --filter @fleet-maintenance/web lint",
    "typecheck": "corepack pnpm --filter @fleet-maintenance/web typecheck",
