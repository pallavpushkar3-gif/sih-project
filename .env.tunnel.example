# Dedicated synthetic session demo, never use the ordinary operational DB.
FLEET_POSTGRES_PASSWORD=
FLEET_RABBITMQ_PASSWORD=
FLEET_RELEASE_DATABASE_URL=postgresql+psycopg://fleet:REPLACE@postgres:5432/fleet_public_demo
FLEET_RELEASE_BROKER_URL=amqp://fleet:REPLACE@rabbitmq:5672//
FLEET_ALLOWED_ORIGINS=["https://pallavpushkar3-gif.github.io","https://REPLACE_WITH_TUNNEL_HOST"]
# none permits credentialed cross-site requests; strict for the single-origin fallback.
FLEET_COOKIE_SAMESITE=none
